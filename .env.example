# ═══════════════════════════════════════════════════════════════════════════════
# Cognify — Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y .env.local y reemplaza los valores.
# NUNCA commits .env ni .env.local con valores reales.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase (Cliente y Autenticación) ────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[TU-PROYECTO].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...[TU-ANON-KEY]

# ── Supabase Admin (Solo servidor — NUNCA exponer al cliente) ──────────────────
# Necesaria para operaciones admin como borrar usuarios en el callback OAuth.
# Supabase Dashboard → Settings → API → Service Role Key
# ⚠️ CRÍTICO: Esta clave bypasea RLS. Nunca la uses en el cliente (sin NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=ey...[TU-SERVICE-ROLE-KEY]

# ── Administrador ─────────────────────────────────────────────────────────────
# Correo del administrador principal.
# Este usuario será auto-promocionado al rol "Administrador" en su primer login.
ADMIN_EMAIL=admin@cognify.com
